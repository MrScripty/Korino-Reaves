# EditorConfig for UAsset Viewer
# https://editorconfig.org

root = true

# Default settings for all files
[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# TypeScript, JavaScript, Svelte, JSON, CSS - 2 space indentation
[*.{ts,js,svelte,json,css,scss,html}]
indent_size = 2

# C# project files - 2 space indentation (XML)
[*.{csproj,props,targets,sln}]
indent_size = 2

# YAML files - 2 space indentation
[*.{yml,yaml}]
indent_size = 2

# Markdown - preserve trailing whitespace for line breaks
[*.md]
trim_trailing_whitespace = false

# Shell scripts
[*.sh]
indent_size = 2

# Makefiles require tabs
[Makefile]
indent_style = tab

# Git config files
[.git*]
indent_size = 2
