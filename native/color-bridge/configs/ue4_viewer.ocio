ocio_profile_version: 2

description: Color configuration for UE4 Asset Viewer — defines color spaces for texture import and rendering.

search_path: ""

roles:
  scene_linear: Linear
  rendering: Linear
  default: sRGB
  data: Raw
  color_picking: sRGB

displays:
  Viewer:
    - !<View> {name: sRGB, colorspace: sRGB}
    - !<View> {name: Raw, colorspace: Linear}

active_displays: [Viewer]
active_views: [sRGB, Raw]

colorspaces:
  # Scene-linear working space — Rec.709/sRGB primaries, D65 white point.
  # This is the rendering working space (matches Godot's internal linear RGB).
  - !<ColorSpace>
    name: Linear
    aliases: [scene_linear, lin_srgb]
    family: Linear
    description: |
      Scene-linear with Rec.709/sRGB primaries and D65 white point.
      Used as the rendering working space in Godot.
    isdata: false
    allocation: lg2
    allocationvars: [-12, 12]

  # sRGB display encoding — the standard for most 8-bit textures.
  # UE4 stores diffuse/albedo and emissive textures in this space.
  - !<ColorSpace>
    name: sRGB
    aliases: [srgb, sRGB - Texture]
    family: Display
    description: |
      sRGB encoding per IEC 61966-2-1.
      Most UE4 color textures (diffuse, emissive) use this space.
    isdata: false
    from_scene_reference: !<GroupTransform>
      children:
        - !<ExponentWithLinearTransform>
          gamma: 2.4
          offset: 0.055
          direction: inverse

  # Adobe RGB (1998) — used by some digital cameras and creative tools.
  - !<ColorSpace>
    name: AdobeRGB
    aliases: [adobergb, Adobe RGB (1998)]
    family: Display
    description: |
      Adobe RGB (1998) color space.
      Wider gamut than sRGB, used by some cameras and design tools.
    isdata: false
    from_scene_reference: !<GroupTransform>
      children:
        # Rec.709 → Adobe RGB gamut via 3x3 matrix (Bradford adaptation)
        - !<MatrixTransform>
          matrix: [
             1.7160966, -0.3556627, -0.2533665, 0,
            -0.6666479,  1.6164776,  0.0157685, 0,
             0.0176313, -0.0427953,  0.9421700, 0,
             0,           0,          0,         1
          ]
        # Adobe RGB uses a simple 2.2 gamma (no linear segment)
        - !<ExponentTransform>
          value: [2.19921875, 2.19921875, 2.19921875, 1]
          direction: inverse

  # Raw / Non-color data — pass-through for data textures.
  # Normal maps, roughness, metallic, opacity masks.
  - !<ColorSpace>
    name: Raw
    aliases: [raw, Non-Color, data]
    family: Data
    description: |
      Non-color data. No transform applied.
      Used for normal maps, roughness, metallic, and mask textures.
    isdata: true
