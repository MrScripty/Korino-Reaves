<Project Sdk="Godot.NET.Sdk/4.4.0">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>UAssetViewer</RootNamespace>
    <AssemblyName>UAssetViewer</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- CEF Integration -->
  <ItemGroup>
    <PackageReference Include="CefGlue.Common" Version="131.3.5" />
    <PackageReference Include="CefGlue" Version="131.3.5" />
  </ItemGroup>

  <!-- Logging & Telemetry -->
  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="OpenTelemetry" Version="1.11.2" />
    <PackageReference Include="OpenTelemetry.Api" Version="1.11.2" />
  </ItemGroup>

  <!-- JSON Serialization -->
  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="9.0.2" />
  </ItemGroup>

  <!-- Asset Parsing -->
  <ItemGroup>
    <PackageReference Include="UAssetAPI" Version="1.3.2" />
    <PackageReference Include="CUE4Parse" Version="25.0.3" />
    <PackageReference Include="CUE4Parse-Conversion" Version="25.0.3" />
  </ItemGroup>
</Project>
