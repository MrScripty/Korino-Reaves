<Project Sdk="Godot.NET.Sdk/4.6.0">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>UAssetViewer</RootNamespace>
    <AssemblyName>UAssetViewer</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Suppress Semantic Kernel experimental API warnings and brace style enforcement -->
    <NoWarn>$(NoWarn);SKEXP0070;IDE0011</NoWarn>
    <!-- Godot.NET.Sdk doesn't copy NuGet assemblies to output by default -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- Exclude test files from main build -->
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>

  <!-- Logging & Telemetry -->
  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="OpenTelemetry" Version="1.11.2" />
    <PackageReference Include="OpenTelemetry.Api" Version="1.11.2" />
  </ItemGroup>

  <!-- JSON Serialization -->
  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="9.0.2" />
  </ItemGroup>

  <!-- Asset Parsing -->
  <ItemGroup>
    <ProjectReference Include="../UAssetAPI/UAssetAPI/UAssetAPI.csproj" />
    <PackageReference Include="CUE4Parse" Version="1.2.2" />
    <PackageReference Include="CUE4Parse-Conversion" Version="1.2.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="2.88.9" />
  </ItemGroup>

  <!-- Data Persistence -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.1" />
  </ItemGroup>

  <!-- AI Agent Framework -->
  <ItemGroup>
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.32.0" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.Ollama" Version="1.32.0-alpha" />
  </ItemGroup>

  <!-- Native zlib-ng libraries (required for PAK decompression) -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <None Include="native/runtimes/linux-x64/native/libz-ng.so.2"
          CopyToOutputDirectory="PreserveNewest" Link="libz-ng.so.2" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <None Include="native/runtimes/win-x64/native/zlib-ng2.dll"
          CopyToOutputDirectory="PreserveNewest" Link="zlib-ng2.dll" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <None Include="native/runtimes/osx-x64/native/libz-ng.2.dylib"
          CopyToOutputDirectory="PreserveNewest" Link="libz-ng.2.dylib"
          Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'X64'" />
    <None Include="native/runtimes/osx-arm64/native/libz-ng.2.dylib"
          CopyToOutputDirectory="PreserveNewest" Link="libz-ng.2.dylib"
          Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'Arm64'" />
  </ItemGroup>
</Project>
