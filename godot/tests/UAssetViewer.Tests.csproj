<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>UAssetViewer.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <PackageReference Include="FluentAssertions" Version="7.0.0" />
    <PackageReference Include="System.Text.Json" Version="9.0.2" />
  </ItemGroup>

  <!-- Asset parsing packages (for integration tests) -->
  <ItemGroup>
    <PackageReference Include="UAssetAPI" Version="1.3.2" />
  </ItemGroup>

  <!-- Reference the main project source files directly (no Godot dependency) -->
  <ItemGroup>
    <Compile Include="../scripts/Models/**/*.cs" />
    <Compile Include="../scripts/Infrastructure/IAppLogger.cs" />
    <Compile Include="../scripts/Bridge/IpcDispatcher.cs" />
    <Compile Include="../scripts/Bridge/Handlers/IMessageHandler.cs" />
    <Compile Include="../scripts/Bridge/Handlers/TestHandler.cs" />
    <Compile Include="../scripts/Services/**/*.cs" />
    <Compile Include="../scripts/Agent/AgentCapabilityRegistry.cs" />
    <Compile Include="../scripts/Agent/AgentExecutionPolicy.cs" />
    <Compile Include="../scripts/Agent/Capabilities/CapabilityModels.cs" />
    <Compile Include="../scripts/Agent/Capabilities/IProjectPathProvider.cs" />
    <Compile Include="../scripts/Agent/Capabilities/IProjectExplorerCapability.cs" />
    <Compile Include="../scripts/Agent/Capabilities/ProjectExplorerCapability.cs" />
    <Compile Include="../scripts/Agent/Capabilities/IDependencyDataAccess.cs" />
    <Compile Include="../scripts/Agent/Capabilities/IDependencyGraphCapability.cs" />
    <Compile Include="../scripts/Agent/Capabilities/DependencyGraphCapability.cs" />
    <Compile Include="../scripts/Agent/Capabilities/IMetadataCapability.cs" />
    <Compile Include="../scripts/Agent/Capabilities/MetadataCapability.cs" />
    <Compile Include="../scripts/Agent/Capabilities/ISelectionStateController.cs" />
    <Compile Include="../scripts/Agent/Capabilities/ISelectionBroadcaster.cs" />
    <Compile Include="../scripts/Agent/Capabilities/IGuiSelectionCapability.cs" />
    <Compile Include="../scripts/Agent/Capabilities/GuiSelectionCapability.cs" />
    <!-- Asset layer - Godot-agnostic parts only -->
    <Compile Include="../scripts/Assets/AssetLoader.cs" />
    <Compile Include="../scripts/Assets/TreeBuilder.cs" />
    <Compile Include="../scripts/Assets/PropertyService.cs" />
    <Compile Include="../scripts/Assets/MappingsManager.cs" />
    <Compile Include="../scripts/Assets/AssetManager.cs" />
  </ItemGroup>
</Project>
